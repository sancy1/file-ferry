<!--
FILE:     Directory.Packages.props
PURPOSE:  Central Package Management (CPM) - one place for every NuGet
          version used anywhere in the solution.
RELATION: Automatically imported by the .NET SDK. Each .csproj keeps its
          <PackageReference Include="..." /> but drops the Version attribute.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia UI stack -->
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.2" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />

    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!-- Portfolio.Resilience 0.8.0 -->
    <PackageVersion Include="Portfolio.Resilience" Version="0.8.0" />
    <PackageVersion Include="Portfolio.Resilience.Analyzers" Version="0.8.0" />

    <!-- Test helpers -->
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />

    <!-- Format writers -->
    <!-- DocumentFormat.OpenXml pinned to 3.5.1 because DocSharp.Docx 0.21.0
         (Phase 11) requires >= 3.5.1. ClosedXML 0.104.2 requires >= 3.1.1;
         3.5.1 satisfies both. -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="QuestPDF" Version="2024.12.3" />
    <!-- PdfPig: PDF text extraction for the Prompt App's importer (P3.5). -->
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="PdfPig.Rendering.Skia" Version="0.1.16.7" />
    <PackageVersion Include="ClosedXML" Version="0.104.2" />

    <!-- Transitive security fix: DocumentFormat.OpenXml 3.1.x pulls in
         System.IO.Packaging 8.0.0, which has a known high-severity
         vulnerability (GHSA-f32c-w444-8ppv, GHSA-qj66-m88j-hmgj).
         Pinning a patched version here overrides the transitive one. -->
    <PackageVersion Include="System.IO.Packaging" Version="9.0.0" />

    <!-- Dependency injection -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Cloud SDKs (Group C) -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.1" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Google.Cloud.Storage.V1" Version="5.0.0" />
    <PackageVersion Include="Google.Apis.Drive.v3" Version="1.77.0.4276" />
    <PackageVersion Include="Microsoft.Graph" Version="6.7.0" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.90.1" />
    <PackageVersion Include="Dropbox.Api" Version="7.4.0" />
    <PackageVersion Include="Meziantou.Framework.Win32.CredentialManager" Version="3.0.4" />
  </ItemGroup>

  <!-- CodeViewer: read-only code surface and syntax highlighting. -->
  <ItemGroup>
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.3" />
  </ItemGroup>

  <!-- ImageTextify: OCR and image processing. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="LLamaSharp" Version="0.30.0" />
    <PackageVersion Include="LLamaSharp.Backend.Cpu" Version="0.30.0" />
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.NoAvx" Version="1.9.1" />
  </ItemGroup>

  <!-- Phase 10: audio capture (microphone and system loopback). -->
  <ItemGroup>
    <PackageVersion Include="NAudio" Version="3.3.0" />
  </ItemGroup>

  <!-- Phase 9: camera capture. -->
  <ItemGroup>
    <PackageVersion Include="Periphery.Camera" Version="5.0.0" />
    <PackageVersion Include="Periphery.Camera.Avalonia" Version="5.0.0" />
  </ItemGroup>

  <!-- Phase 11: Document/Image Conversion. MIT, no key, no watermark. -->
  <ItemGroup>
    <PackageVersion Include="Meziantou.Framework.Imaging" Version="1.2.12" />
    <PackageVersion Include="DocSharp.Docx" Version="0.21.0" />
    <PackageVersion Include="DocSharp.Markdown" Version="0.21.0" />
    <PackageVersion Include="TinyPdf" Version="0.2.0" />
    <PackageVersion Include="Aspose.Cells.FOSS" Version="26.10.0" />
    <PackageVersion Include="SuperConvert" Version="1.0.5.2" />
  </ItemGroup>

  <!-- Phase 13: text-to-speech (System.Speech fallback + Edge neural TTS). -->
  <ItemGroup>
    <PackageVersion Include="System.Speech" Version="9.0.0" />
    <PackageVersion Include="EdgeTTS.DotNet" Version="0.4.0" />
  </ItemGroup>

  <!-- Phase 14: screenshot capture (System.Drawing.Common, Windows-only). -->
  <ItemGroup>
    <PackageVersion Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
</Project>
