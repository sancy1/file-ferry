<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FileHarvester.Core\FileHarvester.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FileHarvester.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cloud name catalog, embedded with an explicit logical name so
         the manifest resource name matches the constant in
         CloudNameCatalog exactly, independent of RootNamespace. -->
    <EmbeddedResource Include="Cloud\Discovery\Resources\cloud-name-catalog.json">
      <LogicalName>FileHarvester.Platform.Cloud.Discovery.Resources.cloud-name-catalog.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Cloud SDKs (Group C) -->
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Azure.Storage.Blobs" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Google.Cloud.Storage.V1" />
    <PackageReference Include="Google.Apis.Drive.v3" />
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Dropbox.Api" />
    <PackageReference Include="Meziantou.Framework.Win32.CredentialManager" />
  </ItemGroup>

</Project>
