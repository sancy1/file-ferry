<!--
FILE:     src/FileHarvester.App/MainWindow.axaml
PURPOSE:  The main window. Two title bars: the Windows native one
          (minimize/maximize/close) and our custom branding bar below it
          (logo, Cloud, Log, theme toggle). The body hosts one page
          through a ContentControl: the harvest page or the cloud page.
RELATION: Bound to MainWindowViewModel.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FileHarvester.App.ViewModels"
        xmlns:views="using:FileHarvester.App.Views"
        mc:Ignorable="d"
        d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="FileHarvester.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="/Assets/file-ferry-logo.png"
        Width="1200" Height="720"
        MinWidth="500" MinHeight="500">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!-- Custom bar / body + overlay / status bar -->
    <Grid RowDefinitions="48,*,28">

        <!-- ROW 0: OUR CUSTOM BAR (native Windows bar sits above it) -->
        <Border Grid.Row="0"
                Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- LEFT: logo + app name -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Spacing="10">
                    <Image Source="{Binding LogoUri}"
                           Width="24" Height="24"
                           Stretch="Uniform"
                           IsVisible="{Binding HasLogo}"
                           VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppName}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- MIDDLE: spacer -->
                <Border Grid.Column="1" Background="Transparent" />

                <!-- RIGHT: workspace navigation, Log, and theme toggle -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Margin="0,0,12,0">

                    <Button Name="OpenHarvestButton"
                            Classes="titleBarButton"
                            Classes.active="{Binding IsHarvestActive}"
                            Content="Harvest File"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Back to the harvest workspace"
                            Command="{Binding OpenHarvestCommand}" />

                    <Button Name="OpenCloudButton"
                            Classes="titleBarButton"
                            Classes.active="{Binding IsCloudActive}"
                            Content="Cloud"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Cloud connections"
                            Command="{Binding OpenCloudCommand}" />

                    <Button Name="OpenLinkJoinerButton"
                            Classes="titleBarButton"
                            Classes.active="{Binding IsLinkJoinerActive}"
                            Content="Link Joiner"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Join a base location to multiple paths"
                            Command="{Binding OpenLinkJoinerCommand}" />

                    <Button Name="OpenExtractButton"
                            Classes="titleBarButton"
                            Classes.active="{Binding IsExtractActive}"
                            Content="Extract"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Extract links, paths, emails, and phone-like text"
                            Command="{Binding OpenExtractCommand}" />

                    <Button Name="OpenImageTextifyButton"
                            Classes="titleBarButton"
                            Classes.active="{Binding IsImageTextifyActive}"
                            Content="ImageTextify"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Extract text from images, PDFs, audio, and video"
                            AutomationProperties.Name="ImageTextify"
                            Command="{Binding OpenImageTextifyCommand}" />

                    <Button Name="OpenPromptButton"
                            Classes="titleBarButton"
                            Classes.active="{Binding IsPromptActive}"
                            Content="Prompt"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Local prompt and document manager"
                            AutomationProperties.Name="Prompt"
                            Command="{Binding OpenPromptCommand}" />

                    <Button Name="OpenCodeViewerButton"
                            Classes="titleBarButton"
                            Classes.active="{Binding IsCodeViewerActive}"
                            Content="Code Viewer"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Inspect local project structure and code"
                            AutomationProperties.Name="Code Viewer"
                            Command="{Binding OpenCodeViewerCommand}" />

                    <Button Name="OpenDeploymentVaultButton"
                            Classes="titleBarButton"
                            Classes.active="{Binding IsDeploymentVaultActive}"
                            Content="Deployment Vault"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Local registry of deployed applications and infrastructure"
                            AutomationProperties.Name="Deployment Vault"
                            Command="{Binding OpenDeploymentVaultCommand}" />

                    <Button Name="OpenSchemaLenceButton"
                            Classes="titleBarButton"
                            Classes.active="{Binding IsSchemaLenceActive}"
                            Content="SchemaLence"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Read-only database explorer and backup workspace"
                            Command="{Binding OpenSchemaLenceCommand}" />

                    <Button Name="ScreenshotButton"
                            Classes="titleBarButton"
                            Content="Screenshot"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Capture a screenshot"
                            AutomationProperties.Name="Screenshot"
                            Command="{Binding TakeScreenshotCommand}" />

                    <Button Name="OpenLogButton"
                            Classes="titleBarButton"
                            Content="Log"
                            FontSize="12"
                            Padding="12,4"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextPrimary}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="View pipeline log"
                            Command="{Binding LogDrawer.OpenCommand}" />

                    <Button Name="ThemeToggleButton"
                            Content="🌗"
                            FontSize="14"
                            Width="36" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="Toggle light / dark theme" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY + OVERLAY -->
        <Grid Grid.Row="1">
            <ContentControl Name="PageHost" />

            <views:LogDrawer DataContext="{Binding LogDrawer}" />
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2"
                Background="{DynamicResource ChromeBrush}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Ready"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <TextBlock Grid.Column="1" Text="File-Ferry 1.4.0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
