<!--
FILE:     src/FileHarvester.App/Views/PromptTagPromptDialog.axaml
PURPOSE:  The bulk add-tag prompt. A single TextBox for the tag and the
          OK/Cancel. The OK returns the trimmed tag; the Cancel closes with
          no result.
RELATION: Opened by PromptPage.axaml.cs's OnBulkAddTagRequested; bound to
          PromptTagPromptViewModel; the result is passed to
          PromptListViewModel.BulkAddTagAsync.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FileHarvester.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="400" d:DesignHeight="180"
        x:Class="FileHarvester.App.Views.PromptTagPromptDialog"
        x:DataType="vm:PromptTagPromptViewModel"
        Title="Add Tag"
        Width="400" Height="180"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceRaised}">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Tag" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
            <TextBox Text="{Binding Tag, Mode=TwoWay}" FontSize="13" PlaceholderText="e.g. history" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0">
            <Button Grid.Column="1" Content="Cancel" Padding="12,6" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Content="Add Tag" Padding="12,6" FontWeight="SemiBold"
                    IsEnabled="{Binding CanAdd}" Command="{Binding OkCommand}" />
        </Grid>
    </Grid>
</Window>