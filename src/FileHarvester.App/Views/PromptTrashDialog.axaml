<!--
FILE:     src/FileHarvester.App/Views/PromptTrashDialog.axaml
PURPOSE:  The trash dialog. Lists the soft-deleted prompts; Restore (the
          selected prompt); Empty Trash (the confirmation in the code-behind;
          then the VM's EmptyTrashAsync); Close.
RELATION: Opened by PromptPage.axaml.cs when the Trash button is clicked.
          Bound to PromptTrashDialogViewModel. The Empty Trash button's click
          is handled in the code-behind (the confirmation dialog).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FileHarvester.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="520" d:DesignHeight="420"
        x:Class="FileHarvester.App.Views.PromptTrashDialog"
        x:DataType="vm:PromptTrashDialogViewModel"
        Title="Trash"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceRaised}">

    <Window.Styles>
        <!-- F-272: the sidebar's ListBoxItem density. The trash list
             inherits Padding=0,1 and MinHeight=0 (the default
             ListBoxItem padding/MinHeight is the wide row the user
             reported). The scope is this Window; no leak to other
             windows. -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16">

        <TextBlock Grid.Row="0" Text="Soft-deleted prompts" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceSubtle}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSm}">
            <ListBox ItemsSource="{Binding TrashRows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PromptListRowViewModel">
                        <TextBlock Text="{Binding Title}" FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" FontSize="11"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"
                   Margin="0,8,0,0" IsVisible="{Binding StatusText}" />

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
            <Button Grid.Column="1" Content="Restore" Padding="12,6" Command="{Binding RestoreCommand}" />
            <Button Grid.Column="2" Content="Empty Trash" Padding="12,6" Click="OnEmptyTrashClicked" />
            <Button Grid.Column="3" Content="Close" Padding="12,6" Command="{Binding CancelCommand}" />
        </Grid>
    </Grid>
</Window>