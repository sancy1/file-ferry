<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileHarvester.App.ViewModels"
             x:Class="FileHarvester.App.Views.LinkJoinerPage"
             x:DataType="vm:MainWindowViewModel">
    <Grid Name="WorkspaceGrid" Margin="12" ColumnDefinitions="1.1*,12,0.9*">
        <Border Name="InputPane" Grid.Column="0"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="16">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Link Joiner"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Apply a base location to many relative paths."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Add Section"
                            Padding="12,6"
                            Background="#2E9E5B"
                            Foreground="White"
                            CornerRadius="6"
                            Command="{Binding LinkJoiner.AddSectionCommand}" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding LinkJoiner.Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Border Background="{DynamicResource SurfaceSubtle}"
                                        BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusMd}"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Text="{Binding Name, Mode=TwoWay}"
                                                     FontSize="13"
                                                     PlaceholderText="Section name" />
                                            <Button Grid.Column="1"
                                                    Content="Remove"
                                                    Padding="10,4"
                                                    Margin="8,0,0,0"
                                                    Background="#C0392B"
                                                    Foreground="White"
                                                    CornerRadius="6"
                                                    Command="{Binding RemoveCommand}" />
                                        </Grid>
                                        <TextBlock Text="Base location"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding BaseLocation, Mode=TwoWay}"
                                                     FontSize="12"
                                                     PlaceholderText="Choose or enter an absolute folder path" />
                                            <Button Grid.Column="1"
                                                    Content="Browse folder…"
                                                    Padding="10,4"
                                                    Background="#2D6CDF"
                                                    Foreground="White"
                                                    CornerRadius="6"
                                                    Command="{Binding BrowseBaseCommand}" />
                                            <Button Grid.Column="2"
                                                    Content="Add files…"
                                                    Padding="10,4"
                                                    Background="#2E9E5B"
                                                    Foreground="White"
                                                    CornerRadius="6"
                                                    Command="{Binding AddFilesCommand}" />
                                        </Grid>
                                        <TextBlock Text="Paths (one per line; selected files are absolute pass-through paths)"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBox Text="{Binding Paths, Mode=TwoWay}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="NoWrap"
                                                 MinHeight="150"
                                                 FontSize="12"
                                                 PlaceholderText="src\App.cs&#x0a;docs\guide.md"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                                        <CheckBox Content="Normalize separators in joined results"
                                                  IsChecked="{Binding NormalizeSeparators, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="8" Margin="0,10,0,0">
                    <CheckBox Content="Remove duplicate results"
                              IsChecked="{Binding LinkJoiner.RemoveDuplicates, Mode=TwoWay}" />
                    <Button Content="Join All"
                            HorizontalAlignment="Stretch"
                            Padding="14,8"
                            FontWeight="SemiBold"
                            Background="#2E9E5B"
                            Foreground="White"
                            CornerRadius="6"
                            Command="{Binding LinkJoiner.JoinAllCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <GridSplitter Name="PaneSplitter" Grid.Column="1"
                      Width="12"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="True" />

        <Border Name="ResultsPane" Grid.Column="2"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="16">
            <Grid RowDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="Results"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding LinkJoiner.StatusText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <Grid Grid.Row="1" RowDefinitions="*,Auto" RowSpacing="10">
                    <TextBox Name="ResultsTextBox"
                             Text="{Binding LinkJoiner.ResultsText}"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             FontSize="12"
                             PlaceholderText="Joined paths will appear here."
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                    <TextBox Grid.Row="1"
                             Text="{Binding LinkJoiner.RowDetails}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="50"
                             MaxHeight="110"
                             FontSize="11"
                             PlaceholderText="Pass-through, blank, and invalid rows are shown here."
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Results are preview-only until you copy, save, or send them to Harvest."
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,10,0,8" />

                <StackPanel Grid.Row="3" Spacing="8">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Name="CopySelectedButton" Content="Copy selected" Padding="10,6"
                                Background="#2D6CDF" Foreground="White" CornerRadius="6" />
                        <Button Grid.Column="1" Content="Copy all" Padding="10,6"
                                Background="#2D6CDF" Foreground="White" CornerRadius="6"
                                Command="{Binding LinkJoiner.CopyAllCommand}" />
                        <Button Grid.Column="2" Content="Save results…" Padding="10,6"
                                Background="#2D6CDF" Foreground="White" CornerRadius="6"
                                Command="{Binding LinkJoiner.SaveResultsCommand}" />
                    </Grid>
                    <Border Height="1"
                            Background="{DynamicResource BorderSubtle}"
                            HorizontalAlignment="Stretch" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Content="Send to Harvest" Padding="10,6"
                                Background="#2E9E5B" Foreground="White" CornerRadius="6"
                                Command="{Binding LinkJoiner.SendToHarvestCommand}" />
                        <Button Grid.Column="1" Content="Clear" Padding="10,6"
                                Background="#C0392B" Foreground="White" CornerRadius="6"
                                Command="{Binding LinkJoiner.ClearCommand}" />
                        <Button Grid.Column="2" Content="Close" Padding="10,6"
                                Background="#7F8C8D" Foreground="White" CornerRadius="6"
                                Command="{Binding LinkJoiner.CloseCommand}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
