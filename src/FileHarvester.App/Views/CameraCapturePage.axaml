<!--
FILE:     src/FileHarvester.App/Views/CameraCapturePage.axaml
PURPOSE:  The live camera capture workspace page. Two-pane layout: controls on
          the left (Back, title, unavailability banner, camera indicator, capture
          lifecycle buttons, status line), live preview on the right using the
          Periphery CameraPreview control. Bindings go through
          MainWindowViewModel.Camera (CameraCaptureViewModel).
RELATION: Selected by MainWindowViewModel.CurrentPage. Page root DataContext is
          inherited from MainWindow; bindings are Camera.* on MainWindowViewModel.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileHarvester.App.ViewModels"
             xmlns:periphery="using:Periphery.Camera.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="640"
             x:Class="FileHarvester.App.Views.CameraCapturePage"
             x:DataType="vm:MainWindowViewModel">

    <Grid Margin="12">
        <Grid ColumnDefinitions="360,6,*">

            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <Button Content="&#x2190; Back to ImageTextify"
                                HorizontalAlignment="Left"
                                Padding="8,4"
                                FontSize="11"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondary}"
                                ToolTip.Tip="Return to the ImageTextify workspace"
                                AutomationProperties.Name="Back to ImageTextify"
                                Command="{Binding OpenImageTextifyCommand}" />

                        <TextBlock Text="Camera Capture"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Point a camera at a document, freeze a frame, and send it through the same OCR pipeline."
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" />

                        <Border Background="{DynamicResource SurfaceSubtle}"
                                BorderBrush="#C0392B"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Padding="10"
                                IsVisible="{Binding Camera.ShowUnavailability}">
                            <TextBlock Text="{Binding Camera.UnavailabilityText}"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Border>

                        <Border Background="#2D6CDF"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Padding="10"
                                IsVisible="{Binding Camera.IsActive}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#x25CF;" FontSize="14" Foreground="White" />
                                <TextBlock Text="{Binding Camera.DeviceLabel}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Open camera"
                                    Padding="12,6" FontWeight="SemiBold"
                                    Foreground="White" Background="#2E9E5B" CornerRadius="6"
                                    IsEnabled="{Binding Camera.CanStart}"
                                    Command="{Binding Camera.OpenCommand}"
                                    AutomationProperties.Name="Open the camera and start the preview"
                                    ToolTip.Tip="Start the live preview on the selected camera" />
                            <Button Content="Capture"
                                    Padding="12,6" FontWeight="SemiBold"
                                    Foreground="White" Background="#16A085" CornerRadius="6"
                                    Command="{Binding Camera.CaptureCommand}"
                                    AutomationProperties.Name="Capture a still frame"
                                    ToolTip.Tip="Freeze the current frame" />
                            <Button Content="Retake"
                                    Padding="12,6"
                                    Foreground="White" Background="#7F8C8D" CornerRadius="6"
                                    Command="{Binding Camera.RetakeCommand}"
                                    AutomationProperties.Name="Return to live preview" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Use this frame"
                                    Padding="12,6"
                                    Foreground="White" Background="#2D6CDF" CornerRadius="6"
                                    Command="{Binding Camera.UseFrameCommand}"
                                    AutomationProperties.Name="Send the frozen frame to OCR"
                                    ToolTip.Tip="Extract text from the frozen frame into ImageTextify results" />
                            <Button Content="Save frame (PNG)"
                                    Padding="12,6"
                                    Foreground="White" Background="#8E44AD" CornerRadius="6"
                                    Command="{Binding Camera.SaveFrameCommand}"
                                    AutomationProperties.Name="Save the frozen frame as PNG"
                                    ToolTip.Tip="Save the frozen frame as a PNG file" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Discard"
                                    Padding="12,6"
                                    Foreground="White" Background="#C0392B" CornerRadius="6"
                                    Command="{Binding Camera.DiscardCommand}"
                                    AutomationProperties.Name="Discard the frozen frame" />
                            <Button Content="Close camera"
                                    Padding="12,6"
                                    Foreground="White" Background="#34495E" CornerRadius="6"
                                    Command="{Binding Camera.CloseCommand}"
                                    AutomationProperties.Name="Close the camera and release the device" />
                        </StackPanel>

                        <TextBlock Text="{Binding Camera.StatusText}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondary}" />

                        <!-- Device picker: choosing a device is the explicit user
                             action that opens the camera session and starts the preview. -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Camera"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Camera.Devices}"
                                      SelectedItem="{Binding Camera.SelectedDevice, Mode=TwoWay}"
                                      AutomationProperties.Name="Camera device">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderSubtle}" ShowsPreview="True" />

            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Padding="24">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Preview"
                               FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource TextPrimary}" />
                    <Grid Grid.Row="1">
                        <periphery:CameraPreview Device="{Binding Camera.PreviewDevice, Mode=OneWay}"
                                                 IsVisible="{Binding Camera.IsActive}"
                                                 MaxResolution="1280,720" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8" MaxWidth="480"
                                    IsVisible="{Binding !Camera.IsActive}">
                            <TextBlock Text="Camera preview"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Open the camera to see the live preview here."
                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
