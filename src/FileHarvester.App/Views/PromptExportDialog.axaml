<!--
FILE:     src/FileHarvester.App/Views/PromptExportDialog.axaml
PURPOSE:  The export dialog. Format dropdown (from the registry), destination
          folder (with a Browse button), output file name, overwrite and
          "Open folder after save" checkboxes, Cancel and Export buttons.
RELATION: Opened by PromptPage.axaml.cs when the viewer's Export button is
          clicked. Bound to PromptExportDialogViewModel. The Browse button's
          click is handled in the code-behind (the native folder picker).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FileHarvester.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="520" d:DesignHeight="400"
        x:Class="FileHarvester.App.Views.PromptExportDialog"
        x:DataType="vm:PromptExportDialogViewModel"
        Title="Export Prompt"
        Width="520" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceRaised}">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="16">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="Format" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Formats}"
                      SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                      MinWidth="220"
                      FontSize="12">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FormatOptionViewModel">
                        <TextBlock Text="{Binding DisplayText}" FontSize="12" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="Destination" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <TextBox Grid.Column="1" Text="{Binding DestinationPath, Mode=TwoWay}" FontSize="12" />
            <Button Grid.Column="2" Content="Browse..." Padding="10,4" Click="OnBrowseDestinationClicked" />
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="File name" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
            <TextBox Grid.Column="1" Text="{Binding OutputFileName, Mode=TwoWay}" FontSize="12" PlaceholderText="Prompt title" />
        </Grid>

        <TextBlock Grid.Row="3" Text="{Binding FilePreviewText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
            <CheckBox IsChecked="{Binding OverwriteExisting, Mode=TwoWay}" Content="Overwrite existing file" FontSize="12" />
            <CheckBox IsChecked="{Binding OpenFolderAfterSave, Mode=TwoWay}" Content="Open folder after save" FontSize="12" />
            <CheckBox IsChecked="{Binding SaveToZip, Mode=TwoWay}" Content="Save to zip" FontSize="12"
                      IsEnabled="{Binding IsSingleExport}" />
        </StackPanel>

        <TextBlock Grid.Row="5" Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" IsVisible="{Binding StatusText}" />

        <Grid Grid.Row="7" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
            <Button Grid.Column="1" Content="Cancel" Padding="12,6" Command="{Binding CancelCommand}" />
            <Button Grid.Column="2" Content="Export" Padding="12,6" FontWeight="SemiBold"
                    IsEnabled="{Binding CanExport}" Command="{Binding ExportCommand}" />
        </Grid>
    </Grid>
</Window>