<!--
FILE:     src/FileHarvester.App/Views/TextToSpeechPage.axaml
PURPOSE:  The text-to-speech workspace page. Two-pane layout: paste/load text
          on the left; status, result path, and the Speak/Pause/Resume/Stop/
          Synthesize/Reset controls on the right. Back to ImageTextify at
          top-left of the left pane.
RELATION: Selected by MainWindowViewModel.CurrentPage through the page host.
          Bindings go through MainWindowViewModel.TextToSpeech. Compile bindings
          are OFF in this initial shell (the TextToSpeech property is added in
          the next step) and are turned back ON in the next edit.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileHarvester.App.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="640"
             x:Class="FileHarvester.App.Views.TextToSpeechPage"
             x:DataType="vm:MainWindowViewModel"
             >

    <Grid Margin="12">
        <Grid ColumnDefinitions="420,6,*">

            <!-- LEFT PANE: TEXT INPUT -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Padding="16">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Button Grid.Row="0" Content="&#x2190; Back to ImageTextify"
                            HorizontalAlignment="Left"
                            Padding="8,4"
                            FontSize="11"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource TextSecondary}"
                            ToolTip.Tip="Return to the ImageTextify workspace"
                            AutomationProperties.Name="Back to ImageTextify"
                            Command="{Binding OpenImageTextifyCommand}" />

                    <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,8">
                        <TextBlock Text="Text to speak"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Paste text here, or load a .txt file. Both paths feed the same box."
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>

                    <Grid Grid.Row="2" RowDefinitions="*,Auto">
                        <TextBox Grid.Row="0"
                                 Text="{Binding TextToSpeech.TextInput, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Padding="8"
                                 FontFamily="{DynamicResource AppMonospaceFont}"
                                 AutomationProperties.Name="Text to speak" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <Button Content="Load file (.txt)"
                                    Padding="12,6"
                                    Foreground="White"
                                    Background="#2D6CDF"
                                    CornerRadius="6"
                                    Command="{Binding TextToSpeech.LoadFileCommand}"
                                    AutomationProperties.Name="Load text file"
                                    ToolTip.Tip="Open a .txt file into the text box" />
                            <Button Content="Reset"
                                    Padding="12,6"
                                    Foreground="White"
                                    Background="#C0392B"
                                    CornerRadius="6"
                                    Command="{Binding TextToSpeech.ResetCommand}"
                                    AutomationProperties.Name="Reset text and result" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderSubtle}" ShowsPreview="True" />

            <!-- RIGHT PANE: RESULT + CONTROLS -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Padding="24">
                <Grid RowDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="Speak or synthesize"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding TextToSpeech.StatusText}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8" MaxWidth="560"
                                    IsVisible="{Binding !TextToSpeech.HasResult}">
                            <TextBlock Text="Ready to speak"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Click Speak to play aloud, or Synthesize to WAV to write a file."
                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8" MaxWidth="640"
                                    IsVisible="{Binding TextToSpeech.HasResult}">
                            <TextBlock Text="Saved"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding TextToSpeech.LastSavedPath}"
                                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Grid>

                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Speak"
                                Padding="14,8" Margin="0,0,8,8"
                                FontWeight="SemiBold"
                                Foreground="White" Background="#2E9E5B" CornerRadius="6"
                                IsEnabled="{Binding TextToSpeech.CanSpeak}"
                                Command="{Binding TextToSpeech.SpeakCommand}"
                                AutomationProperties.Name="Speak text" />
                        <Button Content="Pause"
                                Padding="14,8" Margin="0,0,8,8"
                                Foreground="White" Background="#7F8C8D" CornerRadius="6"
                                IsEnabled="{Binding TextToSpeech.CanPauseResumeStop}"
                                Command="{Binding TextToSpeech.PauseCommand}"
                                AutomationProperties.Name="Pause speaking" />
                        <Button Content="Resume"
                                Padding="14,8" Margin="0,0,8,8"
                                Foreground="White" Background="#2D6CDF" CornerRadius="6"
                                IsEnabled="{Binding TextToSpeech.CanPauseResumeStop}"
                                Command="{Binding TextToSpeech.ResumeCommand}"
                                AutomationProperties.Name="Resume speaking" />
                        <Button Content="Stop"
                                Padding="14,8" Margin="0,0,8,8"
                                Foreground="White" Background="#C0392B" CornerRadius="6"
                                IsEnabled="{Binding TextToSpeech.CanPauseResumeStop}"
                                Command="{Binding TextToSpeech.StopCommand}"
                                AutomationProperties.Name="Stop speaking" />
                        <Button Content="Synthesize to WAV"
                                Padding="14,8" Margin="0,0,8,8"
                                Foreground="White" Background="#16A085" CornerRadius="6"
                                IsEnabled="{Binding TextToSpeech.CanSynthesize}"
                                Command="{Binding TextToSpeech.SynthesizeCommand}"
                                AutomationProperties.Name="Synthesize to WAV file"
                                ToolTip.Tip="Pick a destination and write a WAV file" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
