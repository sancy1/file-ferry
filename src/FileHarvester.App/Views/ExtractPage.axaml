<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileHarvester.App.ViewModels"
             x:Class="FileHarvester.App.Views.ExtractPage"
             x:DataType="vm:MainWindowViewModel">
    <Grid Name="WorkspaceGrid" Margin="12" ColumnDefinitions="1*,6,1*">
        <Border Name="InputPane" Grid.Column="0"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="16">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Extract"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Find text that looks like links, paths, emails, or phone-like numbers. Matches are not verified."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Paste"
                            Padding="10,6"
                            AutomationProperties.Name="Paste text from clipboard"
                            Command="{Binding Extract.PasteCommand}" />
                    <Button Grid.Column="2"
                            Content="Clear input"
                            Padding="10,6"
                            Command="{Binding Extract.ClearInputCommand}" />
                </Grid>

                <TextBox Grid.Row="1"
                         Text="{Binding Extract.InputText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="180"
                         FontSize="13"
                         AutomationProperties.Name="Text to extract matches from"
                         PlaceholderText="Paste or type text here. Extraction stays on this device."
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />

                <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,10,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Extract.CharacterCount, StringFormat='{}{0} characters'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Extract.LineCount, StringFormat='{}{0} lines'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button Grid.Row="0" Grid.ColumnSpan="2"
                                Content="Extract All"
                                Padding="12,8"
                                FontWeight="SemiBold"
                                Command="{Binding Extract.ExtractAllCommand}" />
                        <Button Grid.Row="1" Grid.Column="0"
                                Content="Links &amp; Paths"
                                Padding="10,6"
                                Command="{Binding Extract.ExtractLinksCommand}" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Content="Emails"
                                Padding="10,6"
                                Command="{Binding Extract.ExtractEmailsCommand}" />
                        <Button Grid.Row="2" Grid.Column="0"
                                Content="Phones"
                                Padding="10,6"
                                Grid.ColumnSpan="2"
                                Command="{Binding Extract.ExtractPhonesCommand}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Name="PaneSplitter" Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource BorderSubtle}"
                      ShowsPreview="True" />

        <Border Name="ResultsPane" Grid.Column="2"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}"
                Padding="16">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                    <TextBlock Text="Matches found"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{Binding Extract.StatusText}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="Input changed since extraction. Extract again before copying or saving."
                               IsVisible="{Binding !Extract.ResultsAreCurrent}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Margin="0,0,0,8">
                    <Button Grid.Column="0"
                            Classes="titleBarButton"
                            Classes.active="{Binding Extract.IsAllFilterActive}"
                            Content="{Binding Extract.AllCount, StringFormat='All ({0})'}"
                            Padding="5,6"
                            Command="{Binding Extract.ShowAllCommand}" />
                    <Button Grid.Column="1"
                            Classes="titleBarButton"
                            Classes.active="{Binding Extract.IsLinksFilterActive}"
                            Content="{Binding Extract.LinksAndPathsCount, StringFormat='Links &amp; Paths ({0})'}"
                            Padding="5,6"
                            Command="{Binding Extract.ShowLinksCommand}" />
                    <Button Grid.Column="2"
                            Classes="titleBarButton"
                            Classes.active="{Binding Extract.IsEmailsFilterActive}"
                            Content="{Binding Extract.EmailsCount, StringFormat='Emails ({0})'}"
                            Padding="5,6"
                            Command="{Binding Extract.ShowEmailsCommand}" />
                    <Button Grid.Column="3"
                            Classes="titleBarButton"
                            Classes.active="{Binding Extract.IsPhonesFilterActive}"
                            Content="{Binding Extract.PhonesCount, StringFormat='Phones ({0})'}"
                            Padding="5,6"
                            Command="{Binding Extract.ShowPhonesCommand}" />
                </Grid>

                <Grid Grid.Row="2">
                    <ListBox Name="ResultsListBox"
                             ItemsSource="{Binding Extract.VisibleItems}"
                             SelectionMode="Multiple"
                             AutomationProperties.Name="Extracted matches"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding CategoryLabel}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding Value}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Copy"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Copy this match"
                                            Command="{Binding CopyCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Extract.NoMatchesText}"
                               IsVisible="{Binding !Extract.HasResults}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="24"
                               Foreground="{DynamicResource TextSecondary}" />
                </Grid>

                <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,10,0,0">
                    <CheckBox Grid.Row="0"
                              Content="Include category headings and counts in saved text"
                              IsChecked="{Binding Extract.IncludeCategoryHeadings, Mode=TwoWay}" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0" Name="CopySelectedButton"
                                Content="Copy selected"
                                Padding="10,6" />
                        <Button Grid.Row="0" Grid.Column="1"
                                Content="Copy active category"
                                Padding="10,6"
                                Command="{Binding Extract.CopyActiveCategoryCommand}" />
                        <Button Grid.Row="1" Grid.Column="0"
                                Content="Copy all results"
                                Padding="10,6"
                                Command="{Binding Extract.CopyAllCommand}" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Content="Save results…"
                                Padding="10,6"
                                Command="{Binding Extract.SaveResultsCommand}" />
                        <Button Grid.Row="2" Grid.Column="0"
                                Content="Clear results"
                                Padding="10,6"
                                Command="{Binding Extract.ClearResultsCommand}" />
                        <Button Grid.Row="2" Grid.Column="1"
                                Content="Close"
                                Padding="10,6"
                                Command="{Binding Extract.CloseCommand}" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
