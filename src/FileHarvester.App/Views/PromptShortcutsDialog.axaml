<!--
FILE:     src/FileHarvester.App/Views/PromptShortcutsDialog.axaml
PURPOSE:  The modal keyboard shortcuts reference.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FileHarvester.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="480" d:DesignHeight="360"
        x:Class="FileHarvester.App.Views.PromptShortcutsDialog"
        x:DataType="vm:PromptShortcutsDialogViewModel"
        Title="Keyboard shortcuts"
        Width="480" Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource SurfaceRaised}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
            <TextBlock Text="Keyboard shortcuts" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="These shortcuts work while the Prompt page is open." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtle}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="12,8">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PromptShortcutsDialogViewModel+ShortcutRow">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,4">
                            <TextBlock Grid.Column="0" Text="{Binding Keys}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" MinWidth="130" />
                            <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Button Grid.Row="2" Content="Close" Padding="16,6" HorizontalAlignment="Right" Margin="0,12,0,0" FontWeight="SemiBold" Command="{Binding CloseCommand}" />
    </Grid>
</Window>