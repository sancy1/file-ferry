<!--
FILE:     src/FileHarvester.App/Views/LiveTranscriptionPage.axaml
PURPOSE:  The live transcription workspace page. Two-pane layout: input
          controls on the left (mode, device, language, Start/Stop/Pause/
          Clear, Listening indicator, permission denial state), live
          transcript on the right.
RELATION: Selected by MainWindowViewModel.CurrentPage through the page
          host. Bindings go through MainWindowViewModel.LiveTranscription.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileHarvester.App.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="640"
             x:Class="FileHarvester.App.Views.LiveTranscriptionPage"
             x:DataType="vm:MainWindowViewModel">

    <Grid Margin="12">
        <Grid ColumnDefinitions="410,6,*">

            <!-- LEFT PANE: INPUT CONTROLS -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <Button Content="← Back to ImageTextify"
                                HorizontalAlignment="Left"
                                Padding="8,4"
                                FontSize="11"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextSecondary}"
                                ToolTip.Tip="Return to the ImageTextify workspace"
                                AutomationProperties.Name="Back to ImageTextify"
                                Command="{Binding OpenImageTextifyCommand}" />
                        <TextBlock Text="Live Transcription"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="Capture from your microphone or system audio and transcribe in real time."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" />

                        <!-- Not-available banner -->
                        <Border Background="{DynamicResource SurfaceSubtle}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Padding="10"
                                IsVisible="{Binding !LiveTranscription.IsAvailable}">
                            <TextBlock Text="Live transcription is not available on this platform."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </Border>

                        <!-- Listening indicator -->
                        <Border Background="#2D6CDF" CornerRadius="{DynamicResource RadiusSm}" Padding="10"
                                IsVisible="{Binding LiveTranscription.IsListening}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#x25CF;" FontSize="14" Foreground="White" />
                                <TextBlock Text="Listening..." FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Mode selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Mode" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding LiveTranscription.SelectedModeIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Capture mode">
                                <ComboBoxItem Content="Microphone" />
                                <ComboBoxItem Content="System audio loopback" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Device selector (single item; enumeration is ITX-10.D-004) -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Device" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Audio device">
                                <ComboBoxItem Content="Default device" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Language selector -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Language" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      SelectedIndex="{Binding LiveTranscription.SelectedLanguageIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Language">
                                <ComboBoxItem Content="Auto-detect" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Spanish" />
                                <ComboBoxItem Content="French" />
                                <ComboBoxItem Content="German" />
                                <ComboBoxItem Content="Portuguese" />
                                <ComboBoxItem Content="Italian" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Start"
                                    Padding="12,6"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Background="#2E9E5B"
                                    CornerRadius="6"
                                    IsEnabled="{Binding LiveTranscription.IsIdle}"
                                    Command="{Binding LiveTranscription.StartCommand}"
                                    AutomationProperties.Name="Start live transcription" />
                            <Button Content="Stop"
                                    Padding="12,6"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Background="#C0392B"
                                    CornerRadius="6"
                                    IsEnabled="{Binding LiveTranscription.IsListening}"
                                    Command="{Binding LiveTranscription.StopCommand}"
                                    AutomationProperties.Name="Stop live transcription" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Pause"
                                    Padding="12,6"
                                    Foreground="White"
                                    Background="#7F8C8D"
                                    CornerRadius="6"
                                    IsEnabled="{Binding LiveTranscription.IsListening}"
                                    Command="{Binding LiveTranscription.PauseCommand}"
                                    AutomationProperties.Name="Pause live transcription" />
                            <Button Content="Resume"
                                    Padding="12,6"
                                    Foreground="White"
                                    Background="#2D6CDF"
                                    CornerRadius="6"
                                    IsEnabled="{Binding LiveTranscription.IsPaused}"
                                    Command="{Binding LiveTranscription.ResumeCommand}"
                                    AutomationProperties.Name="Resume live transcription" />
                        </StackPanel>

                        <!-- Permission denial state -->
                        <Border Background="{DynamicResource SurfaceSubtle}"
                                BorderBrush="#C0392B"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Padding="10"
                                IsVisible="{Binding LiveTranscription.ShowPermissionDenied}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Microphone unavailable"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding LiveTranscription.PermissionDeniedText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <!-- Recording toggles -->
                        <StackPanel Spacing="4">
                            <CheckBox Content="Record audio"
                                      FontSize="12"
                                      IsChecked="{Binding LiveTranscription.IsRecordingAudio}" />
                            <CheckBox Content="Record video"
                                      FontSize="12"
                                      IsChecked="{Binding LiveTranscription.IsRecordingVideo}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderSubtle}" ShowsPreview="True" />

            <!-- RIGHT PANE: LIVE TRANSCRIPT -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceRaised}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Padding="24">
                <Grid RowDefinitions="Auto,Auto,*">

                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
                        <TextBlock Text="Transcript"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding LiveTranscription.StatusText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <Button x:Name="CopyTranscriptButton"
                                Content="Copy text"
                                Padding="12,4"
                                FontSize="12"
                                Foreground="White"
                                Background="#2D6CDF"
                                CornerRadius="6"
                                ToolTip.Tip="Copy the full transcript to the clipboard"
                                AutomationProperties.Name="Copy transcript text" />
                        <Button Content="Reset"
                                Padding="12,4"
                                FontSize="12"
                                Foreground="White"
                                Background="#C0392B"
                                CornerRadius="6"
                                Command="{Binding LiveTranscription.ResetCommand}"
                                ToolTip.Tip="Stop listening, clear the transcript, and reset the controls"
                                AutomationProperties.Name="Reset transcript" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding LiveTranscription.Transcript}"
                                 IsVisible="{Binding LiveTranscription.HasTranscript}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Live transcript">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <StackPanel Spacing="2" Margin="0,4">
                                        <TextBlock Text="{Binding TimestampText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="{Binding WarningsText}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.7"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8" MaxWidth="480"
                                    IsVisible="{Binding !LiveTranscription.HasTranscript}">
                            <TextBlock Text="No transcript yet"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Click Start to begin listening."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>