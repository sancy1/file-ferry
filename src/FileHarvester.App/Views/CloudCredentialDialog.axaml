<!--
FILE:     src/FileHarvester.App/Views/CloudCredentialDialog.axaml
PURPOSE:  The dynamic credential form. Renders one field per FieldSpec
          in the selected ProviderProfile. Collects values in memory,
          validates required fields on Save, and closes with an ephemeral
          PendingCredentialSubmission. No persistence, no network.
RELATION: Bound to CloudCredentialFormViewModel. Opened modally by
          CloudPage.axaml.cs on the Configure action for static providers.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FileHarvester.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="520" d:DesignHeight="480"
        x:Class="FileHarvester.App.Views.CloudCredentialDialog"
        x:DataType="vm:CloudCredentialFormViewModel"
        Title="{Binding Title}"
        Width="520" MinWidth="420"
        SizeToContent="Height" MinHeight="320" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/file-ferry-logo.png">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="Enter the credential fields for this provider. Values stay in memory until you save."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <!-- BODY: the dynamic field list -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12,8">

                    <!-- Instance name (Step 5) -->
                    <StackPanel Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="Instance name"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBox Text="{Binding InstanceName, Mode=TwoWay}"
                                 PlaceholderText="e.g. Production, Backup"
                                 FontSize="13" />
                        <TextBlock Text="{Binding InstanceNameError}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="#F87171"
                                   IsVisible="{Binding HasInstanceNameError}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Fields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CredentialFieldViewModel">
                            <StackPanel Spacing="4" Margin="0,0,0,12">

                                <TextBlock Text="{Binding Label}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />

                                <!-- Plain text (Text and Choice kinds) -->
                                <TextBox Text="{Binding Value, Mode=TwoWay}"
                                         PlaceholderText="{Binding Placeholder}"
                                         FontSize="13"
                                         IsVisible="{Binding IsPlainText}" />

                                <!-- Password (masked) -->
                                <TextBox Text="{Binding Value, Mode=TwoWay}"
                                         PlaceholderText="{Binding Placeholder}"
                                         PasswordChar="&#x25CF;"
                                         FontSize="13"
                                         IsVisible="{Binding IsPassword}" />

                                <!-- Multiline -->
                                <TextBox Text="{Binding Value, Mode=TwoWay}"
                                         PlaceholderText="{Binding Placeholder}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="80"
                                         FontSize="13"
                                         IsVisible="{Binding IsMultiline}" />

                                <!-- File (read-only path + Browse) -->
                                <Grid ColumnDefinitions="*,Auto"
                                      IsVisible="{Binding IsFile}">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Value}"
                                             IsReadOnly="True"
                                             PlaceholderText="{Binding Placeholder}"
                                             FontSize="13" />
                                    <Button Grid.Column="1"
                                            Content="Browse..."
                                            FontSize="12"
                                            Padding="12,4"
                                            Margin="8,0,0,0"
                                            Click="OnBrowseClicked" />
                                </Grid>

                                <!-- Help text -->
                                <TextBlock Text="{Binding HelpText}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"
                                           IsVisible="{Binding HasHelpText}" />

                                <!-- Validation message -->
                                <TextBlock Text="{Binding ValidationMessage}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="#F87171"
                                           IsVisible="{Binding HasValidationMessage}" />

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <Button Grid.Column="1"
                    Name="CancelButton"
                    Content="Cancel"
                    FontSize="12"
                    Padding="16,4"
                    Margin="0,0,6,0" />
            <Button Grid.Column="2"
                    Content="Save"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Padding="16,4"
                    Command="{Binding SaveCommand}" />
        </Grid>
    </Grid>
</Window>
