<!--
FILE:     src/FileHarvester.App/Views/CodeFileCardView.axaml
PURPOSE:  One source-code card in the CodeViewer Code Content pane.
          Three bands: a header (file name, full path, role, line count,
          per-file Copy), a no-preview notice for binary/unreadable
          files, and the read-only AvaloniaEdit code surface with line
          numbers and TextMate syntax highlighting.
RELATION: Bound to a CodeFileCardViewModel. The editor is created and
          configured in code-behind so the TextMate installation and the
          theme matching stay in one place.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileHarvester.App.ViewModels"
             xmlns:avaloniaEdit="using:AvaloniaEdit"
             mc:Ignorable="d"
             x:Class="FileHarvester.App.Views.CodeFileCardView"
             x:DataType="vm:CodeFileCardViewModel">

    <Border Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMd}"
            Margin="0,0,0,12">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Header band: name, path, role, line count, Copy -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceSubtle}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="{DynamicResource RadiusMd}"
                    Padding="12,10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding FullPath}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Role}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Text="{Binding LineCountLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemAccentColor}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Copy"
                            Command="{Binding CopyCommand}"
                            VerticalAlignment="Top"
                            Padding="10,4"
                            FontSize="11"
                            Background="#2D6CDF"
                            Foreground="White"
                            CornerRadius="6" />
                </Grid>
            </Border>

            <!-- No-preview notice for binary / unreadable files -->
            <Border Grid.Row="1"
                    IsVisible="{Binding !HasPreview}"
                    Background="{DynamicResource SurfaceSubtle}"
                    Padding="12,8">
                <TextBlock Text="{Binding NoPreviewMessage}"
                           FontSize="11"
                           FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondary}" />
            </Border>

            <!-- Code surface: read-only AvaloniaEdit, line numbers,
                 horizontal scroll for long lines, no vertical scrollbar
                 (the card auto-sizes; the outer pane scrolls). -->
            <Border Grid.Row="2"
                    IsVisible="{Binding HasPreview}"
                    Padding="0">
                <avaloniaEdit:TextEditor Name="CodeEditor"
                                         IsReadOnly="True"
                                         ShowLineNumbers="True"
                                         FontFamily="Consolas, Menlo, monospace"
                                         FontSize="12.5"
                                         HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Disabled"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="4,8" />
            </Border>
        </Grid>
    </Border>
</UserControl>
