<!--
FILE:     src/FileHarvester.App/Views/ProviderPickerDialog.axaml
PURPOSE:  The static-provider picker for the "Use a Credential" path.
          Lists the built-in static-credential providers and returns the
          chosen ProviderProfile. Cancel closes with null. The dialog
          accepts no credential; it only selects a provider.
RELATION: Opened modally by CloudPage.axaml.cs from the "Use a Credential"
          action. Returns ProviderProfile? to the caller.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:domain="using:FileHarvester.Core.Domain"
        mc:Ignorable="d"
        Width="480" Height="420"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="Choose a provider"
        Icon="/Assets/file-ferry-logo.png"
        x:CompileBindings="False"
        x:Class="FileHarvester.App.Views.ProviderPickerDialog">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Choose a provider"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="Select the cloud provider this credential belongs to."
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <!-- BODY: the static provider list -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMd}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding}" Margin="8,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="domain:ProviderProfile">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding DisplayName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,12,0" />
                                <Button Grid.Column="1"
                                        Content="Select"
                                        FontSize="12"
                                        Padding="12,4"
                                        VerticalAlignment="Center"
                                        Click="OnSelectClicked" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="1"
                    Name="CancelButton"
                    Content="Cancel"
                    FontSize="12"
                    Padding="16,4" />
        </Grid>
    </Grid>
</Window>
