<!--
FILE:     src/FileHarvester.App/Views/ResolvedFilesPanel.axaml
PURPOSE:  The Resolved Files panel. Uses a ListBox so rows can be
          selected and double-clicked to open the ambiguity dialog.
RELATION: Bound to ResolvedFilesPanelViewModel. Embedded in MainWindow.axaml.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileHarvester.App.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="500" d:DesignHeight="600"
             x:Class="FileHarvester.App.Views.ResolvedFilesPanel"
             x:DataType="vm:ResolvedFilesPanelViewModel">

    <Border Name="RootBorder"
            Background="{DynamicResource SurfaceRaised}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMd}"
            Padding="16">

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- HEADER -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">

                <TextBlock Grid.Column="0"
                           Text="Resolved Files"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1" Name="ResolveButton" Content="Resolve"
                        FontSize="12" Padding="12,4" Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Command="{Binding ResolveCommand}" />

                <Button Grid.Column="2" Name="CancelButton" Content="Cancel"
                        FontSize="12" Padding="12,4" Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Command="{Binding CancelCommand}" />

                <Button Grid.Column="3" Name="ClearButton" Content="Clear"
                        FontSize="12" Padding="12,4"
                        VerticalAlignment="Center"
                        Command="{Binding ClearCommand}" />
            </Grid>

            <!-- BODY -->
            <Grid Grid.Row="1" MinHeight="120">

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="6"
                            IsVisible="{Binding !Rows.Count}">
                    <TextBlock Text="✅" FontSize="32"
                               HorizontalAlignment="Center" Opacity="0.4" />
                    <TextBlock Text="Nothing to resolve yet"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Add files in the Input panel, then click Resolve"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondary}"
                               Opacity="0.7"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="260"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- Row list - ListBox, not ItemsControl, so double-tap works -->
                <ListBox Name="ResolvedFilesList"
                         ItemsSource="{Binding Rows}"
                         IsVisible="{Binding Rows.Count}"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResolvedFileRowViewModel">
                            <Border Background="Transparent"
                                    BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,8">
                                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">

                                    <Border Grid.Row="0" Grid.RowSpan="2"
                                            Grid.Column="0"
                                            Background="{Binding StatusBrush}"
                                            CornerRadius="10"
                                            Padding="10,3"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            MinWidth="80">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding StatusTextBrush}"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding ResolvedPath}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0" />

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,8,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                                <Binding Path="Note" />
                                                <Binding Path="SizeText" />
                                                <Binding Path="ConfidenceText" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- SUMMARY -->
            <TextBlock Grid.Row="2"
                       Text="{Binding SummaryText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"
                       Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
