<!--
FILE:     src/FileHarvester.App/Views/OverwriteConfirmDialog.axaml
PURPOSE:  Modal overwrite confirmation. Shows the existing file name and
          asks the user to Replace or Cancel, with an optional
          "apply to all remaining files" checkbox.
RELATION: Bound to OverwriteConfirmDialogViewModel. Opened from
          AvaloniaOverwriteConfirmer. The code-behind wires the
          buttons by name and closes with the result.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FileHarvester.App.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="480" d:DesignHeight="220"
        x:Class="FileHarvester.App.Views.OverwriteConfirmDialog"
        x:DataType="vm:OverwriteConfirmDialogViewModel"
        Title="File exists"
        Width="480" Height="220"
        MinWidth="380" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/file-ferry-logo.png">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}">
                <Run Text="A file named " />
                <Run Text="{Binding FileName}"
                     FontFamily="Consolas,Menlo,monospace" />
                <Run Text=" already exists." />
            </TextBlock>
            <TextBlock Text="Replace the existing file, or cancel the save?"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" />
        </StackPanel>

        <!-- BODY -->
        <StackPanel Grid.Row="1" Spacing="8">
            <CheckBox Name="ApplyToAllCheckBox"
                      Content="Apply to all remaining files"
                      IsChecked="{Binding ApplyToAllRemaining, Mode=TwoWay}" />
        </StackPanel>

        <!-- FOOTER -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Name="CancelButton" Content="Cancel"
                    MinWidth="90" />
            <Button Name="ReplaceButton" Content="Replace"
                    MinWidth="90" />
        </StackPanel>

    </Grid>
</Window>
