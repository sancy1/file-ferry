<!--
FILE:     src/FileHarvester.App/Views/PromptListPanel.axaml
PURPOSE:  The sidebar's content view. Category tree on top, prompt list
          below, filtered by the tree selection. The DataContext is
          PromptListViewModel.
RELATION: Hosted by PromptPage.axaml's sidebar Border. Bound to
          PromptListViewModel (P2.3).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileHarvester.App.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="350" d:DesignHeight="600"
             x:Class="FileHarvester.App.Views.PromptListPanel"
             x:DataType="vm:PromptListViewModel">

    <UserControl.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto,*,Auto">

        <!-- SECTION HEADING: CATEGORIES -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,2">
            <TextBlock Grid.Column="0"
                       Classes="sectionHeading"
                       Text="CATEGORIES"
                       Margin="0" />
            <Button Grid.Column="1"
                    Content="Manage"
                    Padding="4,0"
                    Margin="0,0,6,0"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    ToolTip.Tip="Manage categories"
                    Command="{Binding ManageCategoriesCommand}" />
            <Button Grid.Column="2"
                    Content="Show All"
                    Padding="4,0"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    ToolTip.Tip="Show all prompts"
                    Command="{Binding ShowAllCommand}" />
        </Grid>

        <!-- CATEGORY TREE -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceSubtle}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSm}"
                MinHeight="180">
            <TreeView ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="4,2"
                      AutomationProperties.Name="Category tree">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:PromptCategoryRowViewModel"
                                      ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="2,0" />
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- SEPARATOR -->
        <Border Grid.Row="2"
                Height="1"
                Background="{DynamicResource BorderSubtle}"
                Margin="0,4,0,4" />

        <!-- PROMPTS HEADER -->
        <TextBlock Grid.Row="3"
                   Classes="sectionHeading"
                   Text="{Binding ProspectsHeader}"
                   Margin="8,0,0,2" />

        <!-- PROMPT LIST -->
        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceSubtle}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSm}"
                Padding="8,0"
                MinHeight="180">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4" Margin="0,4,0,0"
                      IsVisible="{Binding HasSelection}">
                    <TextBlock Grid.Column="0"
                               Text="{Binding SelectedPrompts.Count, StringFormat='{}{0} selected'}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,0,6,0" />
                    <Button Grid.Column="1" Content="Export" Padding="6,2" FontSize="11" Background="#2D6CDF" Foreground="White" CornerRadius="6" Command="{Binding BulkExportCommand}" />
                    <Button Grid.Column="2" Content="Move" Padding="6,2" FontSize="11" Background="#2D6CDF" Foreground="White" CornerRadius="6" Command="{Binding BulkMoveCommand}" />
                    <Button Grid.Column="3" Content="Tag" Padding="6,2" FontSize="11" Background="#2D6CDF" Foreground="White" CornerRadius="6" Command="{Binding BulkAddTagCommand}" />
                    <Button Grid.Column="4" Content="Delete" Padding="6,2" FontSize="11" Background="#C0392B" Foreground="White" CornerRadius="6" Command="{Binding BulkDeleteCommand}" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding VisiblePrompts}"
                         SelectedItem="{Binding SelectedPrompt, Mode=TwoWay}"
                         SelectedItems="{Binding SelectedPrompts}"
                         SelectionMode="Multiple"
                         Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="Prompt list">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PromptListRowViewModel">
                            <Grid ColumnDefinitions="*,Auto" Margin="4,1">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="&#x2605;"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimary}"
                                           IsVisible="{Binding IsFavorite}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="No prompts in this view."
                           IsVisible="{Binding !VisiblePrompts.Count}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" />
            </Grid>
        </Border>

        <!-- EMPTY TREE STATE (when no categories exist) -->
        <TextBlock Grid.Row="5"
                   Text="No categories yet. The category manager arrives at P2.7."
                   IsVisible="{Binding !Categories.Count}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}"
                   Margin="0,4,0,0" />
    </Grid>
</UserControl>