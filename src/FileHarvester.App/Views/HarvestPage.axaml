<!--
FILE:     src/FileHarvester.App/Views/HarvestPage.axaml
PURPOSE:  The harvest page. Hosts the three-panel layout that was
          previously inline in MainWindow.axaml. The XAML is the
          existing three-panel grid, preserved verbatim.
RELATION: Selected by MainWindowViewModel.CurrentPage through
          PageToViewConverter. The DataContext is inherited from the
          window (MainWindowViewModel); this UserControl does not set
          its own DataContext so the existing bindings resolve
          unchanged. x:DataType is a compile-time hint for the
          compiled bindings, not a DataContext assignment.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:FileHarvester.App.ViewModels"
             xmlns:views="using:FileHarvester.App.Views"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="640"
             x:Class="FileHarvester.App.Views.HarvestPage"
             x:DataType="vm:MainWindowViewModel">

    <Grid Margin="12">
        <Grid ColumnDefinitions="2*,2*,1.4*" ColumnSpacing="12">
            <views:InputPanel Grid.Column="0"
                              DataContext="{Binding InputPanel}" />
            <views:ResolvedFilesPanel Grid.Column="1"
                                      DataContext="{Binding ResolvedFilesPanel}" />
            <views:OutputOptionsPanel Grid.Column="2"
                                      DataContext="{Binding OutputOptionsPanel}" />
        </Grid>
    </Grid>
</UserControl>
